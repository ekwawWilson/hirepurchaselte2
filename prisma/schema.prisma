// HP-Lite data model.
// PostgreSQL provider — matches the legacy hirepurchase app's own database
// (docs/00-legacy-study.md §1 / docs/01-plan.md §1). IDs use @default(uuid()),
// matching legacy's convention (it does not use Postgres-native `@db.Uuid`
// columns for primary keys either, just a plain String holding a UUID string —
// so that's what this schema does too). Status/type fields stay plain String
// with app-level constants (src/lib/constants) and a comment listing valid
// values, not native Postgres enums — legacy itself uses this same convention
// throughout (every `status` field there is `String` + a listing comment, not
// `enum`), so there was nothing to change here.
//
// Money is deliberately NOT copied from legacy: it stores every amount as
// `Float` (basePrice, totalPrice, installmentAmount, outstandingBalance, …).
// HP-Lite keeps integer minor units (`Int`, e.g. `totalPayableMinor`) — this
// is a non-negotiable mission rule ("money as integer minor units, never
// floats"), and floating-point money is exactly the kind of bug the real
// production incident in docs/00-legacy-study.md §4/§6 was about. Matching
// the database *type* (Postgres) does not mean matching every column's data
// type when one of them is a known, documented footgun.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Branches / Auth / RBAC
// ---------------------------------------------------------------------------

model Branch {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users          User[]
  customers      Customer[]
  inventoryItems InventoryItem[]
  contracts      Contract[]

  @@map("branches")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  permissions Permission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  roles Role[]

  @@map("permissions")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  passwordHash String
  firstName    String
  lastName     String
  roleId       String
  branchId     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role   Role    @relation(fields: [roleId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  customersCreated          Customer[]          @relation("CustomerCreatedBy")
  customersUpdated          Customer[]          @relation("CustomerUpdatedBy")
  contractsCreated          Contract[]          @relation("ContractCreatedBy")
  contractsUpdated          Contract[]          @relation("ContractUpdatedBy")
  priceChartEntries         PriceChartEntry[]
  stockMovements            StockMovement[]
  paymentsRecorded          Payment[]           @relation("PaymentCreatedBy")
  paymentsReversed          Payment[]           @relation("PaymentReversedBy")
  auditLogs                 AuditLog[]
  hubtelPreapprovalsCreated HubtelPreapproval[] @relation("HubtelPreapprovalCreatedBy")
  orgSettingsUpdates        OrgSettings[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

// Three phone slots, at least one required (app-level check — see customerService.ts).
// `phone` is the "main" number: whichever number the customer registered first is
// stored here and is what USSD/SMS/direct-debit treat as canonical; phone2/phone3
// are supplementary alternates. All three are independently unique across customers.
model Customer {
  id             String    @id @default(uuid())
  membershipId   String    @unique
  firstName      String
  lastName       String
  phone          String?   @unique
  phone2         String?   @unique
  phone3         String?   @unique
  email          String?
  address        String?
  nationalId     String?
  dateOfBirth    DateTime?
  photoUrl       String?
  guarantorName  String?
  guarantorPhone String?
  branchId       String
  isActivated    Boolean   @default(false)
  createdById    String
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User   @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  updatedBy User?  @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])

  contracts          Contract[]
  payments           Payment[]           @relation("PaymentInitiatedByCustomer")
  smsMessages        SmsMessage[]
  hubtelPreapprovals HubtelPreapproval[]

  @@index([branchId])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Products & Inventory
// ---------------------------------------------------------------------------

model ProductCategory {
  id   String @id @default(uuid())
  name String @unique

  products Product[]

  @@map("product_categories")
}

model Product {
  id             String   @id @default(uuid())
  sku            String   @unique
  name           String
  description    String?
  categoryId     String?
  brand          String?
  model          String?
  cashPriceMinor Int
  imageUrl       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  category          ProductCategory?  @relation(fields: [categoryId], references: [id])
  inventoryItems    InventoryItem[]
  priceChartEntries PriceChartEntry[]
  contracts         Contract[]

  @@map("products")
}

// status: AVAILABLE | RESERVED | ISSUED | RETURNED | WRITTEN_OFF
model InventoryItem {
  id           String   @id @default(uuid())
  productId    String
  branchId     String
  serialNumber String   @unique
  status       String   @default("AVAILABLE")
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  stockMovements StockMovement[]
  contracts      Contract[]

  @@index([productId, branchId, status])
  @@map("inventory_items")
}

// type: RECEIPT | RESERVE | ISSUE | RETURN | TRANSFER | ADJUSTMENT
model StockMovement {
  id              String   @id @default(uuid())
  inventoryItemId String
  productId       String
  branchId        String
  type            String
  fromBranchId    String?
  toBranchId      String?
  referenceType   String?
  referenceId     String?
  reason          String?
  createdById     String
  createdAt       DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  createdBy     User          @relation(fields: [createdById], references: [id])

  @@index([inventoryItemId])
  @@index([branchId, type])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Price chart
// ---------------------------------------------------------------------------

// contractType: SAVE_TO_OWN | DEPOSIT_INSTALMENT | DEVICE_LOAN
// termMonths is admin-facing "number of months" but only ever 3, 4, or 6 — matching
// the legacy hirepurchase app's fixed pricing tiers exactly (its ProductPricing model);
// enforced in priceChartService.validateEntryBody, not a DB constraint (existing/test
// data at other terms stays valid, only new admin-entered rows are constrained).
model PriceChartEntry {
  id                    String    @id @default(uuid())
  productId             String
  contractType          String
  termMonths            Int
  paymentFrequency      String    @default("MONTHLY")
  // Absolute currency amount (like legacy's ProductPricing.depositAmount), not a
  // percentage — admin types in exactly how much deposit this term requires.
  depositAmountMinor    Int       @default(0)
  totalPayableMinor     Int
  instalmentAmountMinor Int
  interestRateBps       Int?
  effectiveFrom         DateTime  @default(now())
  effectiveTo           DateTime?
  createdById           String
  createdAt             DateTime  @default(now())

  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  contracts Contract[]

  @@index([productId, contractType, termMonths, paymentFrequency])
  @@map("price_chart_entries")
}

// ---------------------------------------------------------------------------
// Contracts
// ---------------------------------------------------------------------------

// contractType: SAVE_TO_OWN | DEPOSIT_INSTALMENT | DEVICE_LOAN
// status (union across types, see docs/01-plan.md §5):
//   SAVE_TO_OWN:         ACTIVE | COMPLETED | RELEASED | CANCELLED
//   DEPOSIT_INSTALMENT:  PENDING_DEPOSIT | ACTIVE | COMPLETED | DEFAULTED | CANCELLED
//   DEVICE_LOAN:         ACTIVE | COMPLETED | DEFAULTED | WRITTEN_OFF
model Contract {
  id                  String  @id @default(uuid())
  contractNumber      String  @unique
  contractType        String
  customerId          String
  productId           String
  inventoryItemId     String?
  branchId            String
  priceChartEntryId   String?
  // Direct debit is opt-in per contract, and only for SAVE_TO_OWN's two siblings —
  // see docs/01-plan.md: a free-form-savings contract has no due date to auto-collect
  // against. Presence + status of the linked mandate (not a separate boolean) is what
  // "enabled" means, so this can never drift out of sync with the mandate itself.
  hubtelPreapprovalId String?
  // Captured in the contract wizard when the customer picks Hubtel Direct Debit as
  // their payment method before the contract is eligible for a mandate (DEPOSIT_INSTALMENT
  // starts PENDING_DEPOSIT; mandates require ACTIVE — see hubtelPreapprovalService.ts).
  // Consumed once — the moment the contract activates, initiatePreapproval+enableDirectDebit
  // run automatically using these, then hubtelPreapprovalId above is what "enabled" means
  // from then on. Left populated afterward as a record of what was requested, never re-read.
  pendingDirectDebitNetwork String?
  pendingDirectDebitMsisdn  String?

  // Snapshotted pricing terms — never re-read from priceChartEntries after creation.
  totalPriceMinor       Int
  depositAmountMinor    Int    @default(0)
  termMonths            Int
  paymentFrequency      String @default("MONTHLY")
  instalmentAmountMinor Int

  // DEVICE_LOAN only
  principalMinor  Int?
  interestRateBps Int?
  rateBasis       String? @default("FLAT")

  // Late-payment handling — set per contract in the wizard (docs/01-plan.md's own
  // glossary calls out "Grace Period" but it was never implemented until now).
  // penaltyRateBps of 0 (the default) means no automatic penalty ever applies —
  // see overdueService.applyLatePenalties, which is a no-op for such contracts.
  gracePeriodDays Int @default(7)
  penaltyRateBps  Int @default(0)

  status String @default("ACTIVE")

  totalPayableMinor Int
  totalPaidMinor    Int @default(0)
  balanceMinor      Int

  startDate      DateTime
  activatedAt    DateTime?
  completedAt    DateTime?
  releasedAt     DateTime?
  cancelledAt    DateTime?
  defaultedAt    DateTime?
  writtenOffAt   DateTime?
  cancelReason   String?
  writeOffReason String?

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer          Customer           @relation(fields: [customerId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  inventoryItem     InventoryItem?     @relation(fields: [inventoryItemId], references: [id])
  branch            Branch             @relation(fields: [branchId], references: [id])
  priceChartEntry   PriceChartEntry?   @relation(fields: [priceChartEntryId], references: [id])
  hubtelPreapproval HubtelPreapproval? @relation(fields: [hubtelPreapprovalId], references: [id])
  createdBy         User               @relation("ContractCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?              @relation("ContractUpdatedBy", fields: [updatedById], references: [id])

  instalments        Instalment[]
  payments           Payment[]
  penalties          Penalty[]
  hubtelTransactions HubtelTransaction[]
  ussdSessions       UssdSession[]
  smsMessages        SmsMessage[]

  @@index([status, createdAt])
  @@index([customerId, status])
  @@index([branchId, status])
  @@index([inventoryItemId])
  @@index([hubtelPreapprovalId])
  @@map("contracts")
}

// status: PENDING | PARTIAL | PAID | OVERDUE
model Instalment {
  id                    String    @id @default(uuid())
  contractId            String
  instalmentNo          Int
  dueDate               DateTime
  amountDueMinor        Int
  principalPortionMinor Int       @default(0)
  interestPortionMinor  Int       @default(0)
  amountPaidMinor       Int       @default(0)
  status                String    @default("PENDING")
  paidAt                DateTime?

  contract    Contract            @relation(fields: [contractId], references: [id])
  allocations PaymentAllocation[]
  penalties   Penalty[]

  @@unique([contractId, instalmentNo])
  @@index([contractId, status])
  @@map("instalments")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

// entryType: DEPOSIT | INSTALMENT_PAYMENT | CREDIT
// channel: CASH | USSD
// status: PENDING | SUCCESS | FAILED
model Payment {
  id                    String    @id @default(uuid())
  contractId            String
  entryType             String
  amountMinor           Int
  channel               String
  mobileMoneyNetwork    String?
  transactionRef        String    @unique
  externalRef           String?
  status                String    @default("PENDING")
  receiptNumber         String?
  notes                 String?
  rawGatewayPayload     String?
  createdById           String?
  initiatedByCustomerId String?
  reversesPaymentId     String?   @unique
  reversalReason        String?
  reversedById          String?
  receivedAt            DateTime?
  createdAt             DateTime  @default(now())

  contract            Contract  @relation(fields: [contractId], references: [id])
  createdBy           User?     @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  reversedBy          User?     @relation("PaymentReversedBy", fields: [reversedById], references: [id])
  initiatedByCustomer Customer? @relation("PaymentInitiatedByCustomer", fields: [initiatedByCustomerId], references: [id])
  reverses            Payment?  @relation("PaymentReversal", fields: [reversesPaymentId], references: [id])
  reversedByPayment   Payment?  @relation("PaymentReversal")

  allocations       PaymentAllocation[]
  hubtelTransaction HubtelTransaction?
  smsMessages       SmsMessage[]

  @@index([contractId, status])
  @@map("payments")
}

// targetType: PENALTY | INSTALMENT
model PaymentAllocation {
  id           String  @id @default(uuid())
  paymentId    String
  targetType   String
  instalmentId String?
  penaltyId    String?
  amountMinor  Int

  payment    Payment     @relation(fields: [paymentId], references: [id])
  instalment Instalment? @relation(fields: [instalmentId], references: [id])
  penalty    Penalty?    @relation(fields: [penaltyId], references: [id])

  @@map("payment_allocations")
}

// `reason` is a plain string (not a native enum, matching this schema's convention) —
// 'LATE_PENALTY' is the one value the app creates automatically, in
// overdueService.applyLatePenalties, once an instalment is overdue past its
// contract's gracePeriodDays. Anything else is a manually-recorded penalty.
model Penalty {
  id           String    @id @default(uuid())
  contractId   String
  instalmentId String?
  amountMinor  Int
  reason       String
  appliedDate  DateTime  @default(now())
  isPaid       Boolean   @default(false)
  paidAt       DateTime?

  contract    Contract            @relation(fields: [contractId], references: [id])
  instalment  Instalment?         @relation(fields: [instalmentId], references: [id])
  allocations PaymentAllocation[]

  @@map("penalties")
}

// ---------------------------------------------------------------------------
// Hubtel USSD payments
// ---------------------------------------------------------------------------

// status: PENDING | SUCCESS | FAILED
// channel: USSD (customer-initiated, one-off) | DIRECT_DEBIT (merchant-initiated
// against an APPROVED mandate — see HubtelPreapproval). Retry fields are only ever
// populated for DIRECT_DEBIT: a USSD charge failing just ends the customer's session,
// there's no "merchant retries it later" concept for a channel the customer drove.
model HubtelTransaction {
  id                 String    @id @default(uuid())
  clientReference    String    @unique
  contractId         String
  msisdn             String
  amountMinor        Int
  status             String    @default("PENDING")
  channel            String    @default("USSD")
  preapprovalId      String?
  retryCount         Int       @default(0)
  nextRetryAt        DateTime?
  rawCallbackPayload String?
  paymentId          String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  contract    Contract           @relation(fields: [contractId], references: [id])
  payment     Payment?           @relation(fields: [paymentId], references: [id])
  preapproval HubtelPreapproval? @relation(fields: [preapprovalId], references: [id])

  @@index([status, nextRetryAt])
  @@map("hubtel_transactions")
}

// status: PENDING | APPROVED | FAILED | EXPIRED | CANCELLED
// A mandate the customer approves once (via a USSD prompt or an OTP sent by Hubtel —
// out of band, this app never sees the code) authorizing the merchant to pull future
// payments from their mobile money wallet without asking again each time.
model HubtelPreapproval {
  id                  String    @id @default(uuid())
  customerId          String
  customerMsisdn      String
  network             String // MTN | VODAFONE | TELECEL — AirtelTigo has no direct-debit product
  clientReferenceId   String    @unique
  hubtelPreapprovalId String?
  status              String    @default("PENDING")
  approvedAt          DateTime?
  cancelledAt         DateTime?
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User     @relation("HubtelPreapprovalCreatedBy", fields: [createdById], references: [id])

  contracts          Contract[]
  hubtelTransactions HubtelTransaction[]

  @@index([customerId, customerMsisdn, network])
  @@index([status])
  @@map("hubtel_preapprovals")
}

// msisdn is deliberately NOT a foreign key to Customer.phone — a USSD session
// can start from a number that isn't a registered customer yet (that's what
// the lookup step in the menu is for).
model UssdSession {
  id         String   @id @default(uuid())
  sessionId  String   @unique
  msisdn     String
  state      String
  contractId String?
  context    String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contract Contract? @relation(fields: [contractId], references: [id])

  @@map("ussd_sessions")
}

// ---------------------------------------------------------------------------
// SMS
// ---------------------------------------------------------------------------

model SmsTemplate {
  id           String  @id @default(uuid())
  key          String  @unique
  name         String
  bodyTemplate String
  isActive     Boolean @default(true)

  @@map("sms_templates")
}

// status: QUEUED | SENT | FAILED
model SmsMessage {
  id                String    @id @default(uuid())
  recipient         String
  templateKey       String
  body              String
  relatedPaymentId  String?
  relatedContractId String?
  relatedCustomerId String?
  status            String    @default("QUEUED")
  providerRef       String?
  attempts          Int       @default(0)
  lastAttemptAt     DateTime?
  createdAt         DateTime  @default(now())

  relatedPayment  Payment?  @relation(fields: [relatedPaymentId], references: [id])
  relatedContract Contract? @relation(fields: [relatedContractId], references: [id])
  relatedCustomer Customer? @relation(fields: [relatedCustomerId], references: [id])

  @@map("sms_messages")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValues  String?
  newValues  String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Org settings
// ---------------------------------------------------------------------------

// Single-tenant branding/contact details the client (the business running this
// HP-Lite instance) sets once from the Settings page — shown in the browser
// tab title, the top navbar/sidebar, and on reports. Always exactly one row,
// id pinned to "singleton" (see orgSettingsService.ts) rather than a real
// table of tenants — this app is single-tenant per deployment.
model OrgSettings {
  id          String   @id @default("singleton")
  companyName String   @default("HP-Lite")
  address     String?
  phone       String?
  email       String?
  logoUrl     String?
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("org_settings")
}
