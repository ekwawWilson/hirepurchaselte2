// HP-Lite data model.
// PostgreSQL provider — matches the legacy hirepurchase app's own database
// (docs/00-legacy-study.md §1 / docs/01-plan.md §1). IDs use @default(uuid()),
// matching legacy's convention (it does not use Postgres-native `@db.Uuid`
// columns for primary keys either, just a plain String holding a UUID string —
// so that's what this schema does too). Status/type fields stay plain String
// with app-level constants (src/lib/constants) and a comment listing valid
// values, not native Postgres enums — legacy itself uses this same convention
// throughout (every `status` field there is `String` + a listing comment, not
// `enum`), so there was nothing to change here.
//
// Money is deliberately NOT copied from legacy: it stores every amount as
// `Float` (basePrice, totalPrice, installmentAmount, outstandingBalance, …).
// HP-Lite keeps integer minor units (`Int`, e.g. `totalPayableMinor`) — this
// is a non-negotiable mission rule ("money as integer minor units, never
// floats"), and floating-point money is exactly the kind of bug the real
// production incident in docs/00-legacy-study.md §4/§6 was about. Matching
// the database *type* (Postgres) does not mean matching every column's data
// type when one of them is a known, documented footgun.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Branches / Auth / RBAC
// ---------------------------------------------------------------------------

model Branch {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users          User[]
  customers      Customer[]
  inventoryItems InventoryItem[]
  contracts      Contract[]

  @@map("branches")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  permissions Permission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  roles Role[]

  @@map("permissions")
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  phone              String?
  passwordHash       String
  firstName          String
  lastName           String
  roleId             String
  branchId           String?
  isActive           Boolean   @default(true)
  // Set when an administrator issues or resets the password: the holder must
  // choose their own before doing anything else (authService.ts).
  mustChangePassword Boolean   @default(false)
  // A token issued before this moment is no longer accepted (rbac.ts), so a
  // changed or reset password signs out whoever else was holding one.
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  role   Role    @relation(fields: [roleId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  collectionNotes    CollectionNote[]
  approvalsRequested ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalsDecided   ApprovalRequest[] @relation("ApprovalDecidedBy")

  customersCreated            Customer[]              @relation("CustomerCreatedBy")
  customersUpdated            Customer[]              @relation("CustomerUpdatedBy")
  contractsCreated            Contract[]              @relation("ContractCreatedBy")
  contractsUpdated            Contract[]              @relation("ContractUpdatedBy")
  priceChartEntries           PriceChartEntry[]
  stockMovements              StockMovement[]
  paymentsRecorded            Payment[]               @relation("PaymentCreatedBy")
  paymentsReversed            Payment[]               @relation("PaymentReversedBy")
  auditLogs                   AuditLog[]
  hubtelPreapprovalsCreated   HubtelPreapproval[]     @relation("HubtelPreapprovalCreatedBy")
  orgSettingsUpdates          OrgSettings[]
  loanSettingsUpdates         LoanSettings[]
  operatingSettingsUpdates    OperatingSettings[]
  contractTypeSettingsUpdates ContractTypeSettings[]
  commissionSettingsUpdates   CommissionSettings[]
  contractsApproved           Contract[]              @relation("ContractApprovedBy")
  agentLedgerEntries          AgentDepositLedger[]    @relation("AgentLedgerAgent")
  remittancesFiled            AgentRemittance[]       @relation("AgentRemittanceAgent")
  remittancesConfirmed        AgentRemittance[]       @relation("AgentRemittanceConfirmedBy")
  commissionPayoutsReceived   AgentCommissionPayout[] @relation("AgentPayoutAgent")
  commissionPayoutsMade       AgentCommissionPayout[] @relation("AgentPayoutPaidBy")
  paymentsCollectedAsAgent    Payment[]               @relation("PaymentCollectedByAgent")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

// Three phone slots, at least one required (app-level check — see customerService.ts).
// `phone` is the "main" number: whichever number the customer registered first is
// stored here and is what USSD/SMS/direct-debit treat as canonical; phone2/phone3
// are supplementary alternates. All three are independently unique across customers.
model Customer {
  id                 String    @id @default(uuid())
  membershipId       String    @unique
  firstName          String
  lastName           String
  phone              String?   @unique
  phone2             String?   @unique
  phone3             String?   @unique
  email              String?
  address            String? // residential address — asked for at registration
  occupation         String?
  workAddress        String?
  nationalId         String?
  dateOfBirth        DateTime?
  // A passport-sized JPEG (210x270) stored inline as a data URL, resized in
  // the browser before upload — see CustomerPhotoField and validateCustomerPhoto.
  photoUrl           String?
  // Customer portal (src/app/portal) — a customer signs in with any of their
  // registered phone numbers and a password. Staff issue a one-time password
  // (at registration, or on request); mustChangePassword forces the customer
  // to replace it at first sign-in. No password, no portal access.
  // isActivated flips true once they have chosen their own password.
  passwordHash       String?
  mustChangePassword Boolean   @default(true)
  passwordChangedAt  DateTime?
  portalLastLoginAt  DateTime?
  guarantorName      String?
  guarantorPhone     String?
  branchId           String
  isActivated        Boolean   @default(false)
  createdById        String
  updatedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User   @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  updatedBy User?  @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])

  contracts          Contract[]
  payments           Payment[]           @relation("PaymentInitiatedByCustomer")
  smsMessages        SmsMessage[]
  hubtelPreapprovals HubtelPreapproval[]

  @@index([branchId])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Products & Inventory
// ---------------------------------------------------------------------------

model ProductCategory {
  id                   String @id @default(uuid())
  name                 String @unique
  // What an AGENT keeps out of a cash deposit they collect on a product of
  // this category (Settings > Agent commission). Null: the default amount in
  // CommissionSettings applies. Snapshotted onto AgentDepositLedger.
  agentCommissionMinor Int?

  products Product[]

  @@map("product_categories")
}

model Product {
  id             String   @id @default(uuid())
  sku            String   @unique
  name           String
  description    String?
  categoryId     String?
  brand          String?
  model          String?
  cashPriceMinor Int
  imageUrl       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  category          ProductCategory?  @relation(fields: [categoryId], references: [id])
  inventoryItems    InventoryItem[]
  priceChartEntries PriceChartEntry[]
  contracts         Contract[]

  @@map("products")
}

// status: AVAILABLE | RESERVED | ISSUED | RETURNED | WRITTEN_OFF
// One physical unit, in three levels: category (Laptops) > product (HP
// Laptop) > this unit — its own model name (HP Envy) and specification
// (15" screen, 200 GB HDD, 6 GB RAM, kept in `description`), told apart by
// its serial number / IMEI.
model InventoryItem {
  id           String   @id @default(uuid())
  productId    String
  branchId     String
  serialNumber String   @unique
  name         String?
  description  String?
  status       String   @default("AVAILABLE")
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  stockMovements StockMovement[]
  contracts      Contract[]

  @@index([productId, branchId, status])
  @@map("inventory_items")
}

// type: RECEIPT | RESERVE | ISSUE | RETURN | TRANSFER | ADJUSTMENT
model StockMovement {
  id              String   @id @default(uuid())
  inventoryItemId String
  productId       String
  branchId        String
  type            String
  fromBranchId    String?
  toBranchId      String?
  referenceType   String?
  referenceId     String?
  reason          String?
  createdById     String
  createdAt       DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  createdBy     User          @relation(fields: [createdById], references: [id])

  @@index([inventoryItemId])
  @@index([branchId, type])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Price chart
// ---------------------------------------------------------------------------

// contractType: SAVE_TO_OWN | DEPOSIT_INSTALMENT | DEVICE_LOAN
// termMonths is admin-facing "number of months" but only ever 3, 4, or 6 — matching
// the legacy hirepurchase app's fixed pricing tiers exactly (its ProductPricing model);
// enforced in priceChartService.validateEntryBody, not a DB constraint (existing/test
// data at other terms stays valid, only new admin-entered rows are constrained).
model PriceChartEntry {
  id                    String    @id @default(uuid())
  productId             String
  contractType          String
  termMonths            Int
  paymentFrequency      String    @default("MONTHLY")
  // Absolute currency amount (like legacy's ProductPricing.depositAmount), not a
  // percentage — admin types in exactly how much deposit this term requires.
  depositAmountMinor    Int       @default(0)
  totalPayableMinor     Int
  instalmentAmountMinor Int
  interestRateBps       Int?
  effectiveFrom         DateTime  @default(now())
  effectiveTo           DateTime?
  createdById           String
  createdAt             DateTime  @default(now())

  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  contracts Contract[]

  @@index([productId, contractType, termMonths, paymentFrequency])
  @@map("price_chart_entries")
}

// ---------------------------------------------------------------------------
// Contracts
// ---------------------------------------------------------------------------

// contractType: SAVE_TO_OWN | DEPOSIT_INSTALMENT | DEVICE_LOAN
// status (union across types, see docs/01-plan.md §5):
//   SAVE_TO_OWN:         ACTIVE | COMPLETED | RELEASED | CANCELLED
//   DEPOSIT_INSTALMENT:  PENDING_DEPOSIT | ACTIVE | COMPLETED | DEFAULTED | CANCELLED
//   DEVICE_LOAN:         ACTIVE | COMPLETED | DEFAULTED | WRITTEN_OFF
model Contract {
  id                        String  @id @default(uuid())
  contractNumber            String  @unique
  contractType              String
  customerId                String
  // Set only for DEPOSIT_INSTALMENT, from the reserved inventory item's own
  // product — SAVE_TO_OWN and DEVICE_LOAN are both never linked to a product
  // at all (contractService.ts).
  productId                 String?
  inventoryItemId           String?
  branchId                  String
  priceChartEntryId         String?
  // Direct debit is opt-in per contract, and only for SAVE_TO_OWN's two siblings —
  // see docs/01-plan.md: a free-form-savings contract has no due date to auto-collect
  // against. Presence + status of the linked mandate (not a separate boolean) is what
  // "enabled" means, so this can never drift out of sync with the mandate itself.
  hubtelPreapprovalId       String?
  // Captured in the contract wizard when the customer picks Hubtel Direct Debit as
  // their payment method before the contract is eligible for a mandate (DEPOSIT_INSTALMENT
  // starts PENDING_DEPOSIT; mandates require ACTIVE — see hubtelPreapprovalService.ts).
  // Consumed once — the moment the contract activates, initiatePreapproval+enableDirectDebit
  // run automatically using these, then hubtelPreapprovalId above is what "enabled" means
  // from then on. Left populated afterward as a record of what was requested, never re-read.
  pendingDirectDebitNetwork String?
  pendingDirectDebitMsisdn  String?
  // CUSTOMER_INITIATED (default) — no mandate, customer pays via cash/USSD only.
  // DIRECT_DEBIT — proactively auto-charged every time an instalment is due (today's
  // original behavior). BOTH — customer can self-pay; direct debit only steps in once
  // an instalment is actually OVERDUE (see collectionsService.runDirectDebitCollections),
  // giving the customer their due date to pay themselves first. DIRECT_DEBIT/BOTH both
  // require a mandate (hubtelPreapprovalId) — see hubtelPreapprovalService.enableDirectDebit.
  paymentMethod             String  @default("CUSTOMER_INITIATED")

  // Snapshotted deal terms — entered directly at contract creation, never
  // looked up from a price chart (no contract type reads PriceChartEntry
  // anymore; the column stays only for legacy contracts' historical link).
  // All null for SAVE_TO_OWN: it has no term or instalment amount at all —
  // the customer deposits any amount, any time.
  totalPriceMinor       Int?
  depositAmountMinor    Int    @default(0)
  termMonths            Int? // legacy only — no longer written by any contract type
  termWeeks             Int? // DEPOSIT_INSTALMENT only — 1 to 24, entered directly at creation
  paymentFrequency      String @default("MONTHLY")
  instalmentAmountMinor Int?

  // DEVICE_LOAN only — a daily-simple-interest loan, not linked to a product.
  // principalMinor is the loan amount entered at creation; interestRateBps and
  // gracePeriodDays (below, shared with DEPOSIT_INSTALMENT's late-payment grace)
  // are snapshotted from LoanSettings at creation time, in daily basis points
  // (100 = 1%/day) — never re-read live, same "snapshot, don't re-read"
  // convention as every other pricing field on this model.
  principalMinor  Int?
  interestRateBps Int?
  rateBasis       String? @default("FLAT") // 'DAILY_SIMPLE' for the new DEVICE_LOAN model

  // Late-payment handling — set per contract in the wizard (docs/01-plan.md's own
  // glossary calls out "Grace Period" but it was never implemented until now).
  // penaltyRateBps of 0 (the default) means no automatic penalty ever applies —
  // see overdueService.applyLatePenalties, which is a no-op for such contracts.
  gracePeriodDays Int @default(7)
  penaltyRateBps  Int @default(0)

  status String @default("ACTIVE")

  // Both null for SAVE_TO_OWN — there's no savings target to measure a
  // balance against, only totalPaidMinor (what's actually been deposited).
  // See paymentService.recomputeContract/advanceContractStatus.
  totalPayableMinor Int?
  totalPaidMinor    Int  @default(0)
  balanceMinor      Int?

  startDate      DateTime
  activatedAt    DateTime?
  completedAt    DateTime?
  releasedAt     DateTime?
  cancelledAt    DateTime?
  // What cancelling this contract left owed back to the customer, and what
  // was actually handed over and when (refundedMinor may be less — or nothing,
  // if the customer kept the device). cancelContract only computes the
  // figure; without these it existed for the length of one on-screen message.
  refundDueMinor Int?
  refundedMinor  Int?
  refundedAt     DateTime?
  refundedById   String?
  refundNote     String?
  defaultedAt    DateTime?
  writtenOffAt   DateTime?
  cancelReason   String?
  writeOffReason String?

  // The agent-approval workflow (docs/01-plan.md's Agent module): a contract
  // created by an AGENT-role user starts life at PENDING_APPROVAL instead of
  // its type's usual first status (see CONTRACT_STATUSES_BY_TYPE /
  // contractService.createContract) and only enters its real lifecycle once
  // approvedById is set. An approver may instead send it to
  // REVISION_REQUESTED with revisionReason filled in; the agent edits and
  // resubmits (contractService.resubmitContract), which clears
  // revisionReason and returns it to PENDING_APPROVAL. Null for every
  // contract not created by an agent — those skip this state machine
  // entirely and start at their real initial status straight away.
  submittedForApprovalAt DateTime?
  revisionReason         String?
  approvedById           String?
  approvedAt             DateTime?

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer          Customer           @relation(fields: [customerId], references: [id])
  product           Product?           @relation(fields: [productId], references: [id])
  inventoryItem     InventoryItem?     @relation(fields: [inventoryItemId], references: [id])
  branch            Branch             @relation(fields: [branchId], references: [id])
  priceChartEntry   PriceChartEntry?   @relation(fields: [priceChartEntryId], references: [id])
  hubtelPreapproval HubtelPreapproval? @relation(fields: [hubtelPreapprovalId], references: [id])
  createdBy         User               @relation("ContractCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?              @relation("ContractUpdatedBy", fields: [updatedById], references: [id])
  approvedBy        User?              @relation("ContractApprovedBy", fields: [approvedById], references: [id])

  instalments        Instalment[]
  payments           Payment[]
  penalties          Penalty[]
  hubtelTransactions HubtelTransaction[]
  ussdSessions       UssdSession[]
  smsMessages        SmsMessage[]
  agentDepositLedger AgentDepositLedger?
  collectionNotes    CollectionNote[]
  approvalRequests   ApprovalRequest[]

  @@index([status, createdAt])
  @@index([customerId, status])
  @@index([branchId, status])
  @@index([inventoryItemId])
  @@index([hubtelPreapprovalId])
  @@map("contracts")
}

// status: PENDING | PARTIAL | PAID | OVERDUE
model Instalment {
  id                    String    @id @default(uuid())
  contractId            String
  instalmentNo          Int
  dueDate               DateTime
  amountDueMinor        Int
  principalPortionMinor Int       @default(0)
  interestPortionMinor  Int       @default(0)
  amountPaidMinor       Int       @default(0)
  status                String    @default("PENDING")
  paidAt                DateTime?

  contract    Contract            @relation(fields: [contractId], references: [id])
  allocations PaymentAllocation[]
  penalties   Penalty[]

  @@unique([contractId, instalmentNo])
  @@index([contractId, status])
  @@map("instalments")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

// entryType: DEPOSIT | INSTALMENT_PAYMENT | CREDIT
// channel: CASH | USSD
// status: PENDING | SUCCESS | FAILED
model Payment {
  id                    String    @id @default(uuid())
  contractId            String
  entryType             String
  amountMinor           Int
  channel               String
  mobileMoneyNetwork    String?
  transactionRef        String    @unique
  externalRef           String?
  status                String    @default("PENDING")
  receiptNumber         String?
  notes                 String?
  rawGatewayPayload     String?
  createdById           String?
  initiatedByCustomerId String?
  reversesPaymentId     String?   @unique
  reversalReason        String?
  reversedById          String?
  receivedAt            DateTime?
  // A cash payment an AGENT took from the customer themselves: the money is
  // in their hand until they remit it (AgentDepositLedger). Null for cash
  // paid at the counter, and for every other channel.
  collectedByAgentId    String?
  createdAt             DateTime  @default(now())

  contract            Contract  @relation(fields: [contractId], references: [id])
  createdBy           User?     @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  collectedByAgent    User?     @relation("PaymentCollectedByAgent", fields: [collectedByAgentId], references: [id])
  reversedBy          User?     @relation("PaymentReversedBy", fields: [reversedById], references: [id])
  initiatedByCustomer Customer? @relation("PaymentInitiatedByCustomer", fields: [initiatedByCustomerId], references: [id])
  reverses            Payment?  @relation("PaymentReversal", fields: [reversesPaymentId], references: [id])
  reversedByPayment   Payment?  @relation("PaymentReversal")

  allocations       PaymentAllocation[]
  hubtelTransaction HubtelTransaction?
  smsMessages       SmsMessage[]

  @@index([contractId, status])
  @@map("payments")
}

// targetType: PENALTY | INSTALMENT
model PaymentAllocation {
  id           String  @id @default(uuid())
  paymentId    String
  targetType   String
  instalmentId String?
  penaltyId    String?
  amountMinor  Int

  payment    Payment     @relation(fields: [paymentId], references: [id])
  instalment Instalment? @relation(fields: [instalmentId], references: [id])
  penalty    Penalty?    @relation(fields: [penaltyId], references: [id])

  @@map("payment_allocations")
}

// `reason` is a plain string (not a native enum, matching this schema's convention) —
// 'LATE_PENALTY' is created automatically by overdueService.applyLatePenalties
// once a DEPOSIT_INSTALMENT/DEVICE_LOAN instalment is overdue past its
// contract's gracePeriodDays. 'DAILY_LOAN_INTEREST' is created automatically
// by loanService.accrueDailyLoanInterest — one row per weekday a DEVICE_LOAN's
// principal is still outstanding, `instalmentId` always null for these (there
// is no instalment schedule for a device loan). Anything else is a manually-
// recorded penalty.
model Penalty {
  id           String    @id @default(uuid())
  contractId   String
  instalmentId String?
  amountMinor  Int
  reason       String
  appliedDate  DateTime  @default(now())
  isPaid       Boolean   @default(false)
  paidAt       DateTime?

  contract    Contract            @relation(fields: [contractId], references: [id])
  instalment  Instalment?         @relation(fields: [instalmentId], references: [id])
  allocations PaymentAllocation[]

  @@map("penalties")
}

// ---------------------------------------------------------------------------
// Hubtel USSD payments
// ---------------------------------------------------------------------------

// status: PENDING | SUCCESS | FAILED | NEEDS_REVIEW
// NEEDS_REVIEW: Hubtel collected the money but the ledger refused to record
// it (see hubtelPaymentService.recordSuccessfulHubtelCharge) — staff must
// refund or post it by hand; the reason is in the audit trail.
// channel: USSD (customer-initiated, one-off) | DIRECT_DEBIT (merchant-initiated
// against an APPROVED mandate — see HubtelPreapproval). Retry fields are only ever
// populated for DIRECT_DEBIT: a USSD charge failing just ends the customer's session,
// there's no "merchant retries it later" concept for a channel the customer drove.
model HubtelTransaction {
  id                         String    @id @default(uuid())
  clientReference            String    @unique
  contractId                 String
  msisdn                     String
  amountMinor                Int
  status                     String    @default("PENDING")
  channel                    String    @default("USSD")
  preapprovalId              String?
  retryCount                 Int       @default(0)
  nextRetryAt                DateTime?
  rawCallbackPayload         String?
  paymentId                  String?   @unique
  // A direct-debit attempt may ask for less than the instalment (a partial
  // attempt after the full one bounced); this is the full amount the chain
  // of attempts is collecting. Null for an ordinary full-amount attempt.
  baseAmountMinor            Int?
  // How staff closed a NEEDS_REVIEW transaction that could not be applied to
  // the contract (refunded, posted by hand elsewhere).
  resolvedAt                 DateTime?
  resolvedById               String?
  resolutionNote             String?
  // A payment taken by Hubtel's own checkout after the USSD menu answered
  // AddToCart (ussdCheckoutService.ts): clientReference is then Hubtel's
  // SessionId. Hubtel reports the payment to the Service Fulfilment URL with
  // an OrderId, and must be told within the hour whether the service was
  // rendered. fulfilmentStatus is what it is told (success | failed);
  // fulfilmentCallbackState is PENDING until Hubtel has accepted that,
  // then SENT — or UNDELIVERED once the hour has passed.
  hubtelOrderId              String?
  fulfilmentReceivedAt       DateTime?
  fulfilmentStatus           String?
  fulfilmentCallbackState    String?
  fulfilmentCallbackAttempts Int       @default(0)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  contract    Contract           @relation(fields: [contractId], references: [id])
  payment     Payment?           @relation(fields: [paymentId], references: [id])
  preapproval HubtelPreapproval? @relation(fields: [preapprovalId], references: [id])

  @@index([status, nextRetryAt])
  @@index([fulfilmentCallbackState])
  @@map("hubtel_transactions")
}

// status: PENDING | APPROVED | FAILED | EXPIRED | CANCELLED
// A mandate the customer approves once (via a USSD prompt or an OTP sent by Hubtel —
// out of band, this app never sees the code) authorizing the merchant to pull future
// payments from their mobile money wallet without asking again each time.
model HubtelPreapproval {
  id                  String    @id @default(uuid())
  customerId          String
  customerMsisdn      String
  network             String // MTN | VODAFONE | TELECEL — AirtelTigo has no direct-debit product
  clientReferenceId   String    @unique
  hubtelPreapprovalId String?
  // USSD (customer approves on their own phone via a prompt/*170#) or OTP
  // (Hubtel sends a 4-digit code instead — only for a number already
  // preapproved with a DIFFERENT Hubtel merchant; not selectable by us, see
  // hubtelPreapprovalService.ts). Null in mock mode, which never goes
  // through a real verification step, and for any mandate created before
  // this column existed.
  verificationType    String?
  // The 4-letter prefix Hubtel put in front of the OTP it texted the
  // customer (e.g. "HNRM") — only set when verificationType is OTP. The
  // full code submitted to Hubtel's verifyotp endpoint is "{otpPrefix}-{the
  // 4 digits staff enter}" (see submitPreapprovalOtp); Hubtel's docs give
  // this as one dash-joined string, not two separate fields.
  otpPrefix           String?
  status              String    @default("PENDING")
  approvedAt          DateTime?
  cancelledAt         DateTime?
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User     @relation("HubtelPreapprovalCreatedBy", fields: [createdById], references: [id])

  contracts          Contract[]
  hubtelTransactions HubtelTransaction[]

  @@index([customerId, customerMsisdn, network])
  @@index([status])
  @@map("hubtel_preapprovals")
}

// msisdn is deliberately NOT a foreign key to Customer.phone — a USSD session
// can start from a number that isn't a registered customer yet (that's what
// the lookup step in the menu is for).
model UssdSession {
  id         String   @id @default(uuid())
  sessionId  String   @unique
  msisdn     String
  state      String
  contractId String?
  context    String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contract Contract? @relation(fields: [contractId], references: [id])

  @@map("ussd_sessions")
}

// One row per `kind` (upserted, never accumulated) capturing the most recent
// real request/response for an integration point Hubtel calls into that has
// nothing else durable to source an example from (USSD's Service Flow
// Interaction, and the Preapproval/Transaction-Status-Check APIs, which don't
// persist their raw bodies anywhere else — unlike the payment callback, whose
// real payload already lives on HubtelTransaction.rawCallbackPayload). Powers
// the Settings > Hubtel Diagnostics "sample payloads" panel with genuine
// captured traffic instead of hand-typed illustrative JSON.
model HubtelSampleLog {
  id              String   @id @default(uuid())
  kind            String   @unique // USSD | PREAPPROVAL_CALLBACK | STATUS_CHECK
  requestPayload  String?
  responsePayload String?
  capturedAt      DateTime @default(now())

  @@map("hubtel_sample_logs")
}

// ---------------------------------------------------------------------------
// SMS
