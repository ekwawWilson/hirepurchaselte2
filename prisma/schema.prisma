model SmsTemplate {
  id           String  @id @default(uuid())
  key          String  @unique
  name         String
  bodyTemplate String
  isActive     Boolean @default(true)

  @@map("sms_templates")
}

// status: QUEUED | SENT | FAILED
model SmsMessage {
  id                String    @id @default(uuid())
  recipient         String
  templateKey       String
  body              String
  relatedPaymentId  String?
  relatedContractId String?
  relatedCustomerId String?
  status            String    @default("QUEUED")
  providerRef       String?
  attempts          Int       @default(0)
  lastAttemptAt     DateTime?
  createdAt         DateTime  @default(now())

  relatedPayment  Payment?  @relation(fields: [relatedPaymentId], references: [id])
  relatedContract Contract? @relation(fields: [relatedContractId], references: [id])
  relatedCustomer Customer? @relation(fields: [relatedCustomerId], references: [id])

  @@map("sms_messages")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValues  String?
  newValues  String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Org settings
// ---------------------------------------------------------------------------

// Single-tenant branding/contact details the client (the business running this
// HP-Lite instance) sets once from the Settings page — shown in the browser
// tab title, the top navbar/sidebar, and on reports. Always exactly one row,
// id pinned to "singleton" (see orgSettingsService.ts) rather than a real
// table of tenants — this app is single-tenant per deployment.
model OrgSettings {
  id          String   @id @default("singleton")
  companyName String   @default("PETROS Hirepurchase")
  address     String?
  phone       String?
  email       String?
  logoUrl     String?
  // The installed-app / home-screen / browser-tab icon: a square PNG or JPEG
  // (resized to 512x512 in the browser) stored inline. Kept apart from the
  // logo because a wide logo makes a poor square icon, and out of the public
  // GET /api/settings every page loads. Falls back to the logo, then initials.
  appIconUrl  String?
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("org_settings")
}

// Global DEVICE_LOAN terms — one row (id pinned to "singleton", same
// convention as OrgSettings), edited from Settings > Loan payment terms.
// Every new DEVICE_LOAN contract snapshots these onto itself at creation
// (Contract.interestRateBps/gracePeriodDays) — changing this later reprices
// nothing already created, same "snapshot, don't re-read" rule every other
// pricing field on Contract follows.
model LoanSettings {
  id                   String   @id @default("singleton")
  // Daily basis points charged against the ORIGINAL loan amount every weekday
  // the principal is still outstanding — 100 = 1%/day (loanService.ts).
  dailyInterestRateBps Int      @default(100)
  // Calendar days after the loan's startDate before daily interest starts
  // accruing at all ("days after loan date").
  interestGraceDays    Int      @default(0)
  updatedAt            DateTime @updatedAt
  updatedById          String?

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("loan_settings")
}

// Which weekend days the business actually operates on — one row (id pinned
// to "singleton", same convention as OrgSettings), edited from
// Settings > Working days. Monday-Friday are always working days; only the
// weekend is configurable, which is the only part that varies in practice.
//
// Read LIVE, not snapshotted per contract — unlike the pricing fields on
// Contract, this answers "is the business open today?", an operational fact
// that should take effect everywhere the moment it changes. Instalment due
// dates are the one exception in practice, but only because they're written
// once at contract creation (contractService.ts) and never recomputed, so an
// existing schedule keeps the dates the customer already agreed to.
//
// Consumed by scheduleService (due dates never land on a non-working day),
// loanService (daily interest only accrues on working days) and
// collectionsService (no direct-debit auto-charge on a day you're closed).
// Deliberately NOT consulted when recording a payment — a customer handing
// over cash on a Sunday is always accepted (paymentService.ts).
model OperatingSettings {
  id                          String   @id @default("singleton")
  worksSaturday               Boolean  @default(false)
  worksSunday                 Boolean  @default(false)
  // Whether a customer may still pay on a day the business is closed — a
  // Saturday payment against a Monday instalment, or against loan interest
  // that only accrues on working days. Defaults ON: the common case is a
  // business that doesn't *schedule* anything on the weekend but will
  // gladly take money offered on one. Turning it off blocks only the
  // INITIATION of a new payment (the cash routes and the USSD confirm step),
  // never the recording of one already collected — see
  // assertPaymentsAcceptedToday in operatingSettingsService.ts.
  acceptsPaymentsOnClosedDays Boolean  @default(true)
  updatedAt                   DateTime @updatedAt
  updatedById                 String?

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("operating_settings")
}

// Which optional contract types the business offers — one row (id pinned to
// "singleton", same convention as OrgSettings), edited from
// Settings > Contract types. DEPOSIT_INSTALMENT is always offered; SAVE_TO_OWN
// and DEVICE_LOAN are off until an admin activates them.
//
// Gates only the CREATION of new contracts (contractService.createContract).
// Contracts of a type that is later deactivated keep working: payments,
// withdrawals, USSD, cancellation and every report are unaffected, so no
// customer is ever cut off from money they already hold with the business.
model ContractTypeSettings {
  id                String   @id @default("singleton")
  saveToOwnEnabled  Boolean  @default(false)
  deviceLoanEnabled Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  updatedById       String?

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("contract_type_settings")
}

// ---------------------------------------------------------------------------
// Agent module (docs/01-plan.md's Agent role)
// ---------------------------------------------------------------------------

// The default amount an AGENT keeps out of a cash deposit they collect, for a
// product whose category has no amount of its own (ProductCategory.
// agentCommissionMinor) — snapshotted onto AgentDepositLedger.commissionAmountMinor at the moment the
// deposit is recorded, so a later change here never re-prices a deal already
// settled (the same "snapshot, don't re-read" convention every other pricing
// field on Contract follows). Singleton, edited from Settings > Commission.
model CommissionSettings {
  id                   String   @id @default("singleton")
  fixedCommissionMinor Int      @default(0)
  updatedAt            DateTime @updatedAt
  updatedById          String?

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("commission_settings")
}

// One row per contract an AGENT brought in, once there is anything to settle
// between them and the office: cash they collected on it, or commission
// they have earned on it. Never edited piecemeal — re-derived from the
// payments and remittances whenever any of them changes
// (agentLedgerService.syncAgentLedger), so a split deposit, a reversal or a
// cancellation can never leave it disagreeing with the money.
//
//   balance = depositAmountMinor - commissionAmountMinor
//             - amountRemittedMinor + commissionPaidMinor
//   > 0: the agent owes the office (OWED); < 0: the office owes the agent
//   their commission (DUE_TO_AGENT, e.g. a deposit paid by mobile money);
//   0: SETTLED.
model AgentDepositLedger {
  id                     String   @id @default(uuid())
  contractId             String   @unique
  agentId                String
  // Cash in the agent's hand on this contract: every effective cash payment
  // recorded as collected by them (Payment.collectedByAgentId), net of
  // reversals. Not only the deposit, if they collect instalments too.
  depositAmountMinor     Int
  // Earned once the contract's deposit has been paid in full, however it was
  // paid (Deposit + Instalment sales only); 0 before then, and again if the
  // deposit is unwound. The rate is snapshotted when first earned.
  commissionAmountMinor  Int
  commissionRateMinor    Int?
  // The product category whose rate set the commission, as named at the
  // time; null when the default amount applied.
  commissionCategoryName String?
  // = depositAmountMinor - commissionAmountMinor. Negative when the
  // commission is more than the cash the agent holds.
  amountOwedMinor        Int
  amountRemittedMinor    Int      @default(0)
  // Commission the office has paid out to the agent (AgentCommissionPayout).
  commissionPaidMinor    Int      @default(0)
  status                 String   @default("OWED") // OWED | DUE_TO_AGENT | SETTLED
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  contract    Contract                @relation(fields: [contractId], references: [id])
  agent       User                    @relation("AgentLedgerAgent", fields: [agentId], references: [id])
  remittances AgentRemittance[]
  payouts     AgentCommissionPayout[]

  @@index([agentId, status])
  @@index([agentId, createdAt])
  @@map("agent_deposit_ledger")
}

// One claim, by the agent, of money paid toward one ledger entry — cash
// handed over at the branch, or a mobile money/bank transfer made outside
// this app and reported here with a reference. Never applied to the ledger
// on its own: an approver (BRANCH_MANAGER/ADMIN/SUPER_ADMIN, agent.ledger.manage)
// must confirm it first (agentLedgerService.confirmRemittance), the same
// principle as a cash deposit needing a human to actually count it before
// it counts. A rejected claim leaves the ledger untouched.
model AgentRemittance {
  id              String    @id @default(uuid())
  ledgerId        String
  agentId         String
  amountMinor     Int
  method          String // CASH | MOBILE_MONEY | BANK_TRANSFER
  reference       String? // customer-supplied momo/bank reference — never verified against a live gateway
  status          String    @default("PENDING") // PENDING | CONFIRMED | REJECTED
  rejectionReason String?
  confirmedById   String?
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ledger      AgentDepositLedger @relation(fields: [ledgerId], references: [id])
  agent       User               @relation("AgentRemittanceAgent", fields: [agentId], references: [id])
  confirmedBy User?              @relation("AgentRemittanceConfirmedBy", fields: [confirmedById], references: [id])

  @@index([ledgerId, status])
  @@index([agentId, status])
  @@map("agent_remittances")
}

// Commission the office has paid an agent — on a contract where what they
// earned is more than the cash they held (the deposit was paid by mobile
// money, say). Recorded by an approver (agent.ledger.manage).
model AgentCommissionPayout {
  id          String   @id @default(uuid())
  ledgerId    String
  agentId     String
  amountMinor Int
  method      String // CASH | MOBILE_MONEY | BANK_TRANSFER
  reference   String?
  paidById    String
  createdAt   DateTime @default(now())

  ledger AgentDepositLedger @relation(fields: [ledgerId], references: [id])
  agent  User               @relation("AgentPayoutAgent", fields: [agentId], references: [id])
  paidBy User               @relation("AgentPayoutPaidBy", fields: [paidById], references: [id])

  @@index([agentId])
  @@map("agent_commission_payouts")
}

// Failed sign-ins per account ("staff:<email>" / "portal:<phone>"), so a
// password cannot be guessed without limit. In the database rather than in
// memory so a restart or deploy does not hand an attacker a fresh allowance.
model LoginThrottle {
  key            String    @id
  failures       Int       @default(0)
  firstFailureAt DateTime  @default(now())
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt

  @@map("login_throttles")
}

// One contact with (or attempt to reach) a customer in arrears.
// outcome: NO_ANSWER | SPOKE | PROMISED | VISITED | OTHER
model CollectionNote {
  id                  String    @id @default(uuid())
  contractId          String
  createdById         String
  outcome             String
  note                String
  promisedAmountMinor Int?
  promisedDate        DateTime?
  followUpAt          DateTime?
  createdAt           DateTime  @default(now())

  contract  Contract @relation(fields: [contractId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([contractId, createdAt])
  @@index([followUpAt])
  @@map("collection_notes")
}

// A payment reversal or contract write-off one person asked for, waiting on
// a different person to approve (ControlSettings.requireSecondApproval).
// kind: PAYMENT_REVERSAL | CONTRACT_WRITEOFF. status: PENDING | APPROVED | REJECTED
model ApprovalRequest {
  id            String    @id @default(uuid())
  kind          String
  targetId      String
  contractId    String
  branchId      String
  reason        String
  status        String    @default("PENDING")
  requestedById String
  decidedById   String?
  decisionNote  String?
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?

  contract    Contract @relation(fields: [contractId], references: [id])
  requestedBy User     @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?    @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])

  @@index([status, branchId])
  @@map("approval_requests")
}

// Something that went wrong and needs a person: a payment collected but not
// applied, a scheduled job that failed, Hubtel refusing this account.
// dedupeKey keeps a recurring fault to one open alert rather than one a minute.
model SystemAlert {
  id             String    @id @default(uuid())
  kind           String
  message        String
  dedupeKey      String    @unique
  occurrences    Int       @default(1)
  lastSeenAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([acknowledgedAt])
  @@map("system_alerts")
}

// Controls and notifications an owner switches on or off (Settings > Controls).
model ControlSettings {
  id                        String   @id @default("singleton")
  // A reversal or write-off needs a second, different person to approve it.
  requireSecondApproval     Boolean  @default(true)
  // Where the daily summary and system alerts are texted.
  ownerPhone                String?
  dailySummaryEnabled       Boolean  @default(true)
  // Text the customer the day before a direct debit is due.
  directDebitNoticeEnabled  Boolean  @default(true)
  // When a full direct debit bounces, try half before waiting for the next retry day.
  partialDirectDebitEnabled Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
  updatedById               String?

  @@map("control_settings")
}

// ---------------------------------------------------------------------------
// PayTrigger (Transsion) device locking — src/lib/paytrigger
//
// A sidecar for Device Financing contracts: TECNO, Infinix and itel phones
// that lock themselves when an instalment is still unpaid after the grace
// period. New tables only, joined to the rest of the schema by plain ID
// columns and no relations, so nothing here can change an existing model.
// ---------------------------------------------------------------------------

// Which catalogue products are Transsion phones. An admin confirms each one;
// a product is never treated as one from its name alone.
model PayTriggerProduct {
  id        String   @id @default(uuid())
  productId String   @unique
  brand     String // TECNO | INFINIX | ITEL
  addedById String?
  createdAt DateTime @default(now())

  @@map("paytrigger_products")
}

// One enrolled phone. enrollmentStatus: QUEUED (enrolled, not yet switched
// on) | ACTIVE | UNENFORCEABLE | FAILED | CANCELLED | REMOVED.
// committedState is only ever what the phone itself reported (a callback or
// a status read): LOCKED | UNLOCKED | PENDING | UNKNOWN. A write to
// PayTrigger only makes it PENDING.
model PayTriggerDevice {
  id                String    @id @default(uuid())
  inventoryItemId   String    @unique
  contractId        String?   @unique
  imei              String    @unique
  // PayTrigger's own id for the phone, learned once it is activated.
  deviceTag         String?
  orderRef          String?
  enrollmentStatus  String    @default("QUEUED")
  committedState    String    @default("UNKNOWN")
  // The lock date the contract implies, for staff to read.
  scheduleExpiresAt DateTime?
  // The lock date PayTrigger last accepted.
  providerExpiresAt DateTime?
  // Hash of the last decision applied, so an unchanged one is not resent.
  fingerprint       String?
  // Paid off: the lock is removed for good after this moment.
  releaseAfter      DateTime?
  releaseHeld       Boolean   @default(false)
  // Hash of the lock-screen text PayTrigger last accepted.
  lockMessageKey    String?
  lastConnectAt     DateTime?
  apkVersion        String?
  licenceConsumedAt DateTime?
  lastStatusReadAt  DateTime?
  pinUnlocksUsed    Int       @default(0)
  // Paid, so it should be open, but the phone still reports locked.
  awaitingPinSince  DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([enrollmentStatus])
  @@map("paytrigger_devices")
}

// Outbound commands, idempotent by key, with retries.
// type: EXTEND | LOCK (lock dates sent to a phone)
// status: PENDING | PROCESSING | SUCCEEDED | DEFERRED | FAILED
model PayTriggerCommand {
  id             String    @id @default(uuid())
  deviceId       String
  type           String
  status         String    @default("PENDING")
  idempotencyKey String    @unique
  payload        Json
  attempts       Int       @default(0)
  nextAttemptAt  DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([deviceId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("paytrigger_commands")
}

// Every request made to PayTrigger, sent, simulated or skipped, and every
// callback from it. PayTrigger keeps no history of its own: this is the
// record if a customer disputes a lock. The API key is masked; a PIN is
// never stored.
model PayTriggerActionLog {
  id            String   @id @default(uuid())
  deviceId      String?
  contractId    String?
  action        String
  success       Boolean
  dryRun        Boolean
  providerCode  String?
  skippedReason String?
  request       Json?
  response      Json?
  actorId       String?
  createdAt     DateTime @default(now())

  @@index([deviceId, createdAt])
  @@index([contractId, createdAt])
  @@map("paytrigger_action_logs")
}

// Callbacks from PayTrigger, kept before they are processed and
// de-duplicated by a hash of the body: PayTrigger re-sends until answered.
model PayTriggerWebhookEvent {
  id          String    @id @default(uuid())
  dedupeKey   String    @unique
  notifyType  String
  body        Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@map("paytrigger_webhook_events")
}

// Always exactly one row (Settings > PayTrigger).
model PayTriggerSettings {
  id                       String    @id @default("singleton")
  defaultRuleNum           Int       @default(0)
  // Days after the grace period ends before the phone locks.
  lockAfterOverdueDays     Int       @default(1)
  // An agent's contract stays locked until the deposit cash they took is remitted.
  lockOnUnpaidAgentDeposit Boolean   @default(true)
  maxUnlockHorizonDays     Int       @default(45)
  releaseHoldHours         Int       @default(24)
  extendBreakerPercent     Int       @default(20)
  lockTitle                String    @default("Payment overdue")
  lockTips                 String    @default("Dear {firstName}, your payment of {amount} was due on {dueDate}. Pay to open your phone. Call {supportPhone} for help.")
  depositHoldTitle         String    @default("Phone not yet activated")
  depositHoldTips          String    @default("Your phone will be activated once your agent completes registration. Contact {agentName} on {agentPhone}.")
  unlinkedTitle            String    @default("No contract on this device")
  unlinkedTips             String    @default("This phone has no contract. Please contact {companyName} on {supportPhone}.")
  lastSweepAt              DateTime?
  lastSweepSummary         Json?
  updatedById              String?
  updatedAt                DateTime  @updatedAt

  @@map("paytrigger_settings")
}

// A customer resetting a forgotten portal/app password: a 6-digit code sent
// by SMS to one of their registered numbers (passwordResetService.ts). Only
// a hash of the code is kept; a code expires, allows a few attempts, and is
// used once.
model CustomerPasswordReset {
  id         String    @id @default(uuid())
  customerId String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
  @@map("customer_password_resets")
}
